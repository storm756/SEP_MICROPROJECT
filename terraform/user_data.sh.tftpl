#!/bin/bash
set -euo pipefail

# System update and Docker installation
dnf update -y || apt-get update -y
dnf install -y docker || apt-get install -y docker.io

# Enable and start Docker service
systemctl enable --now docker

# Pull and run the CityServe Docker container
docker pull ${docker_image}
docker run -d \
  --name cityserve \
  --restart unless-stopped \
  -p 80:8000 \
  -v cityserve_data:/data \
  ${docker_image}
